  "fixed_sql": [
    {
      "name": "categories",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL UNIQUE, \"icon\" TEXT NOT NULL, \"color_hex\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL, \"archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"archived\" IN (0, 1)), \"is_default\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_default\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "sources",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"sources\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL UNIQUE, \"icon\" TEXT NOT NULL, \"color_hex\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL, \"archived\" INTEGER NOT NULL DEFAULT 0 CHECK (\"archived\" IN (0, 1)), \"is_default\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_default\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "entries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"entries\" (\"id\" TEXT NOT NULL, \"kind\" TEXT NOT NULL CHECK(\"kind\" IN ('income', 'expense')), \"amount_cents\" INTEGER NOT NULL CHECK(\"amount_cents\" > 0), \"occurred_on\" TEXT NOT NULL, \"category_id\" TEXT NULL REFERENCES categories (id), \"source_id\" TEXT NULL REFERENCES sources (id), \"note\" TEXT NULL, \"origin\" TEXT NOT NULL DEFAULT 'manual' CHECK(\"origin\" IN ('manual', 'auto')), \"account_label\" TEXT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK ((kind = 'expense' AND category_id IS NOT NULL AND source_id IS NULL) OR (kind = 'income' AND source_id IS NOT NULL AND category_id IS NULL)));"
        }
      ]
    },
    {
      "name": "settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings\" (\"id\" INTEGER NOT NULL CHECK(\"id\" = 1), \"mode\" TEXT NOT NULL CHECK(\"mode\" IN ('stable', 'variable', 'survival')), \"space_name\" TEXT NULL, \"runway_window_days\" INTEGER NOT NULL DEFAULT 14 CHECK(\"runway_window_days\" BETWEEN 7 AND 90), \"income_window_days\" INTEGER NOT NULL DEFAULT 30 CHECK(\"income_window_days\" IN (30, 60, 90)), \"opening_balance_cents\" INTEGER NULL, \"opening_balance_at\" INTEGER NULL, \"onboarding_done\" INTEGER NOT NULL DEFAULT 0 CHECK (\"onboarding_done\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "budgets",
      "sql": [
        {
